{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bilgilimedia-60d6f.web.app/schemas/app-config-v2.schema.json",
  "title": "BilgiliMedia App Config v2",
  "type": "object",
  "required": ["schemaVersion", "compatibility", "sections", "categories", "navigation", "features"],
  "properties": {
    "schemaVersion": {"const": 2},
    "updatedAt": {"type": "string"},
    "compatibility": {"type": "object"},
    "sections": {"type": "array"},
    "categories": {"type": "array"},
    "navigation": {
      "type": "object",
      "required": ["version", "maxDepth", "items"],
      "properties": {
        "version": {"const": 1},
        "maxDepth": {"type": "integer", "minimum": 1, "maximum": 6},
        "items": {"type": "array"}
      }
    },
    "extraPages": {"type": "array"},
    "features": {"type": "object"},
    "sponsorAds": {"type": "object"}
  },
  "additionalProperties": true
}
